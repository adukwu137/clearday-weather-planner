# Copy to .env to override defaults. ClearDay needs no API key or login.
PORT=3000
HOST=127.0.0.1
# How long weather and air quality responses are cached, in seconds
CACHE_TTL_SECONDS=600
# Requests per minute allowed per client on /api routes
RATE_LIMIT_PER_MINUTE=120
# Name sent in the X-Serves-By header. Defaults to the machine hostname.
# SERVER_NAME=web-01
